# Niente cache per pagine e script: ogni apertura prende l'ultima versione.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/admin
  Cache-Control: no-cache
/board
  Cache-Control: no-cache
/qr
  Cache-Control: no-cache
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
# Font e immagini non cambiano: cache lunga.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=86400
